# Keep the Docker build context small. Without this the Rust `target/` and the
# web `node_modules/` (often several GB) are shipped to the daemon on every
# build, which is why a naive `docker compose build` transfers gigabytes.

# Build artifacts
target/
**/target/

# Node
web/node_modules/
web/dist/
**/node_modules/

# Models are large and mounted at runtime, not baked into the image.
models/

# Secrets and local state
.env
.env.local
.git/
.gitignore

# Docs / eval data / tooling not needed to build
eval/data/
.ui-craft/
*.md
!README.md

# Editor / OS
.DS_Store
*.swp
