# Absensi Wajah — environment configuration
# Copy to .env and adjust. Never commit .env.

DATABASE_URL=postgres://absensi:absensi@localhost:5432/absensi
BIND_ADDR=0.0.0.0:8080

# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-insecure-change-me
JWT_TTL_SECONDS=28800

DB_POOL_SIZE=16

# Bootstrap admin, created only when the users table is empty.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=admin

# Set to false once ONNX models are present (see scripts/download_models.sh).
USE_DETERMINISTIC_PIPELINE=true

# Decision thresholds — MEASURE these against the school dataset (plan Section 10).
# Defaults below are strict placeholders, not tuned values.
T_ACCEPT=0.50
T_MARGIN=0.08
CONSENSUS_REQUIRED=5
CONSENSUS_WINDOW=7
T_LIVENESS=0.85

# Cooldown between two attendance records for the same student, seconds.
COOLDOWN_SECONDS=300

# Reporting timezone (IANA). Attendance is bucketed into local days with this
# zone, both for the daily report and for "today" defaults. A check-in at 06:30
# WIB belongs to that local day, not the previous UTC day.
TZ=Asia/Jakarta

# ONNX paths (only used when USE_DETERMINISTIC_PIPELINE=false)
FACE_DETECTOR_MODEL=models/det_10g.onnx
FACE_EMBEDDER_MODEL=models/w600k_r50.onnx
FACE_LIVENESS_MODEL=models/minifasnet.onnx
FACE_ORT_THREADS=0

RUST_LOG=info,absensi_server=debug
