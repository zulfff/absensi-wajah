# Copy ke .env dan isi nilai asli. JANGAN commit .env.
# JWT_SECRET: `openssl rand -hex 32`
JWT_SECRET=changeme-generate-with-openssl
# ABSENSI_DB_PASSWORD: `openssl rand -hex 16`
ABSENSI_DB_PASSWORD=changeme
BOOTSTRAP_ADMIN_USER=admin
# BOOTSTRAP_ADMIN_PASSWORD: sandi kuat, ganti setelah login pertama
BOOTSTRAP_ADMIN_PASSWORD=changeme
USE_DETERMINISTIC_PIPELINE=true
# Reporting timezone (IANA) for daily attendance reports. Default Asia/Jakarta.
TZ=Asia/Jakarta
